{%+header_login%}
{%
	import 'luci.sys'
	import 'luci.http'
	import 'nixio.fs'

	var boardinfo = ubus.call('system', 'board')
	var bgUrl = media + '/img/bg1.jpg'

	var result = ubus.call('luci.lumos_wallpaper', 'get_url', {})
	if (result && result.url && result.url != '') {
		bgUrl = result.url
	}
-%}
<!-- Login Page Start -->
<div class="login-page">
	<!-- Image Background Start -->
	<div class="main-bg" id="main-bg" style="background-image:url({{ bgUrl }})"></div>
	<!-- Image Background End -->
	<!-- Login Container Start -->
	<div class="login-container">
		<div class="login-form">
			<!-- Logo Start -->
			<a class="brand" href="/"><img src="{{ media }}/img/lumos.svg" class="icon"></a>
			<span class="brand-text">{{ striptags( (boardinfo.hostname or '?') ) }}</span>
			<!-- Logo End -->
			<!-- Login Form Start -->
			<form class="form-login" method="post" action="{{ pcdata(http.getenv('REQUEST_URI')) }}">
				<input type="hidden" name="luci_username" value="root" />

				{% if (fuser): %}
				<div class="errorbox">{{ translate('Invalid username and/or password! Please try again.') }}</div>
				{% endif %}

				<div class="input-container">
					<div class="input-group pass-icon">
						<input class="cbi-input-password" id="cbi-input-password" type="password" name="luci_password" placeholder="{{ translate('Password') }}" />
						<label class="border" for="cbi-input-password"></label>
					</div>
				</div>
				<div>
					<input type="submit" value="{{ translate('Login') }}" class="cbi-button cbi-button-apply" />
				</div>
			</form>
			<!-- Login Form End -->
			<script type="text/javascript">//<![CDATA[
				var input = document.getElementsByName('luci_password')[0];
				if (input)
					input.focus();
			//]]></script>
			{%
			var https_key = cursor():get('uhttpd', 'main', 'key')
			var https_port = cursor():get('uhttpd', 'main', 'listen_https')
			if (type(https_port) == 'table') {
				https_port = https_port[1]
			}

			if (https_port && fs.access(https_key)) {
				https_port = https_port:match('(%d+)$')
			%}
			<script type="text/javascript">//<![CDATA[
				if (document.location.protocol != 'https:') {
					var url = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + window.location.pathname;
					var img = new Image;
					img.onload = function () { window.location = url };
					img.src = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + '{{ resource }}/cbi/up.gif?' + Math.random();;
					setTimeout(function () {
						img.src = ''
					}, 5000);
				}
			//]]></script>
			{% endif %}
{%+footer%}